# Copy to .streamlit/secrets.toml (local) or paste into
# Streamlit Community Cloud → App settings → Secrets.
# The same keys also work in a .env file.

GROQ_API_KEY = "gsk_..."
GEMINI_API_KEY = "..."

# Keeps uploads, revision history and usage logs across restarts (recommended on Streamlit Cloud)
MONGODB_URI = "mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Enables the Admin page (upload / delete / dashboard). Leave out to disable admin features.
ADMIN_PASSWORD = "choose-a-strong-password"

# Optional
# LLM_PROVIDER = "ollama"          # run fully on-premises with a local model
# OLLAMA_MODEL = "llama3.1:8b"
# USE_RERANKER = "true"            # better ranking, uses ~100 MB more memory
# MIN_VECTOR_SIMILARITY = "0.35"   # tune with eval/run_eval.py
